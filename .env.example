# MongoDB Atlas connection string — Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/bharosashop?retryWrites=true&w=majority

# NextAuth (Auth.js v5) — random secret used to sign/encrypt session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ImageKit (product photos, vendor media, certification docs)
# Get these from https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Used once by `npm run seed:admin` to bootstrap the first admin account.
ADMIN_SEED_EMAIL=admin@bharosashop.in
ADMIN_SEED_PASSWORD=change-me-before-running
